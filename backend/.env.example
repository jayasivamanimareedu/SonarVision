# DRISHTI backend configuration
# Detector backend: "yolo" for the supplied trained model; use "mock" only for UI fallback/testing
DETECTOR_BACKEND=yolo

# Confidence threshold applied to detections (0-1)
CONFIDENCE_THRESHOLD=0.4

# Path to YOLO weights (used only when DETECTOR_BACKEND=yolo)
YOLO_WEIGHTS_PATH=weights/drishti_sss.pt

# Allowed CORS origins (comma-separated). Include your deployed frontend URL
# in production so the browser is permitted to call this API.
# Example:
#   CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Local development: connect the Next.js frontend to your local FastAPI backend
# ---------------------------------------------------------------------------
# 1. Copy this file to `.env.local`  ->  cp .env.local.example .env.local
# 2. Start the backend:
#      cd backend
#      uvicorn app.main:app --reload --port 8000
# 3. Start the frontend (in another terminal):
#      npm run dev
#
# The frontend calls this URL first and only falls back to mock data if the
# backend is unreachable. Use 127.0.0.1 (not localhost) to match the backend's
# CORS allow-list in backend/app/config.py.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
